<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_log"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="P7全视影像"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- v1.57 beta2：开源声明区——免费开源禁倒卖 + 可点击仓库链接 -->
        <TextView
            android:id="@+id/tv_open_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="本软件免费开源 · 禁止倒卖"
            android:textColor="@color/accent_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tv_repo_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://github.com/Hades-Heyds/P7_ViewAssist"
            android:textColor="#FF80C8FF"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_white"
            android:text="关于"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <!-- v1.56 beta2：浮窗总开关独立置顶（原打灯联动开关），金色激活样式保留 -->
        <Button
            android:id="@+id/sw_enable"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_white"
            android:text="浮窗总开关：关闭"
            android:textSize="22sp"
            android:layout_marginTop="8dp"/>

        <!-- v1.56 beta2：分区标题——连接与权限 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="连接与权限"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- v1.54 beta4：悬浮窗权限与相机权限按钮同一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_overlay"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_white"
                android:text="悬浮窗权限"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btn_camera"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_white"
                android:text="相机权限"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- v1.54 beta4：ADB 地址输入框与 ADB 端口输入框同一行（hint 区分，代码回填） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textSize="18sp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_button"
                android:padding="10dp"
                android:inputType="text"
                android:hint="ADB 地址（如 127.0.0.1）"/>

            <EditText
                android:id="@+id/et_port"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_button"
                android:padding="10dp"
                android:inputType="number"
                android:hint="ADB 端口（如 5050）"/>
        </LinearLayout>

        <!-- v1.56 beta2：分区标题——打灯辅助影像 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打灯辅助影像"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- v1.56 beta2：摄像头预览与镜头设置（原连点 10 次隐藏入口改为直接进入） -->
        <Button
            android:id="@+id/btn_camera_test"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_white"
            android:text="摄像头预览与镜头设置"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <!-- v1.54 beta4：还原浮窗设置 与 右转向灯浮窗同步左转向灯浮窗 同一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- v1.43：一键还原左右转向浮窗位置/形状/画面缩放到默认，并把绑定视角归位 display-mode=8 -->
            <Button
                android:id="@+id/btn_reset_overlay"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button"
                android:textColor="@color/accent_gold"
                android:text="还原浮窗设置（位置/形状/画面/视角）"
                android:textSize="14sp"/>

            <!-- v1.46：右浮窗对齐左浮窗（位置/大小/形状）；v1.54 beta4 改名 -->
            <Button
                android:id="@+id/btn_align_right_to_left"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_white"
                android:text="右转向灯浮窗同步左转向灯浮窗"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- v1.56 beta2：分区标题——预警辅助影像 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="预警辅助影像"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- v1.52：BSD 盲区提醒开关（Phase 1 车机验证态，属性未确认时窄条显示灰色） -->
        <Button
            android:id="@+id/btn_bsd"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_white"
            android:text="BSD 盲区提醒：关闭"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>

        <!-- v1.56 beta2：BSD 开关类 2 个一行（无车常显 / 自动弹窗） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- v1.53 beta2：BSD 无车常显调试开关（无车时窄条也保持显示，供拖动调位置/测试） -->
            <Button
                android:id="@+id/btn_bsd_always"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_white"
                android:text="BSD 无车常显：关闭"
                android:textSize="14sp"/>

            <!-- v1.54：BSD 预警自动弹窗开关（开启后 BSD 预警自动弹对应侧摄像头浮窗，默认开） -->
            <Button
                android:id="@+id/btn_bsd_auto_overlay"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_white"
                android:text="BSD 自动弹窗：开"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- v1.56 beta2：BSD 开关类 2 个一行（红遮罩 / 位置复位） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- v1.54 beta3：BSD 预警红色遮罩开关（预警弹窗边界红色警示呼吸圈，默认开） -->
            <Button
                android:id="@+id/btn_bsd_red_overlay"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_white"
                android:text="BSD 红遮罩：开"
                android:textSize="14sp"/>

            <!-- v1.54：BSD 常显窄条位置一键复位（清除 bsd_left/right_x/y，恢复默认位置） -->
            <Button
                android:id="@+id/btn_bsd_reset_pos"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:textColor="@color/accent_gold"
                android:text="BSD 位置复位"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- v1.54 beta4：编辑预警浮窗 与 预警浮窗同步转向灯浮窗 同一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- v1.54 beta4：编辑预警浮窗——召唤/关闭左右预警窗编辑态（拖动/双击编辑/单独关闭保存） -->
            <Button
                android:id="@+id/btn_bsd_edit"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button"
                android:textColor="@color/accent_gold"
                android:text="编辑预警浮窗"
                android:textSize="16sp"/>

            <!-- v1.54 beta4：预警浮窗同步转向灯浮窗（左对左/右对右：位置/大小/画面） -->
            <Button
                android:id="@+id/btn_bsd_sync"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_white"
                android:text="预警浮窗同步转向灯浮窗"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- v1.56 beta2：分区标题——状态与日志 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态与日志"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66FFFFFF"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态：未运行"
            android:textColor="@color/accent_gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"/>

        <!-- v1.43：日志模块上方用户使用说明 -->
        <TextView
            android:id="@+id/tv_usage_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:text="使用说明：\n1. 首次开启「打灯联动」时，车机会弹出 ADB 配对确认，请点击确认；确认后应用会自动重启一次，重新进入即可正常使用。\n2. 浮窗操作：单指拖动浮窗到合适位置（松手自动保存）；双击浮窗进入编辑模式，单指平移画面、双指缩放画面、拖动黄色边缘调整窗口形状，再次双击退出并保存。\n3. 若画面调整乱了调不回来，点击上方「还原浮窗设置」，浮窗位置/形状/画面与绑定视角将全部恢复默认。"/>

        <!-- v1.41：状态日志标题行 + 清空日志按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="状态日志"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"/>

            <Button
                android:id="@+id/btn_clear_log"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/bg_button"
                android:textColor="@color/text_white"
                android:text="清空日志"
                android:textSize="16sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:text=""/>
    </LinearLayout>
</ScrollView>
